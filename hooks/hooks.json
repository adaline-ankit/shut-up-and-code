{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/check.sh\"",
            "timeout": 10,
            "statusMessage": "slopcheck..."
          }
        ]
      }
    ]
  }
}
